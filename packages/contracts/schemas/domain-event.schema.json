{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoqa.dev/schemas/domain-event.schema.json",
  "title": "Domain Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "organizationId",
    "projectId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "correlationId",
    "actorType",
    "actorId",
    "payload"
  ],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
    "eventVersion": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "organizationId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "aggregateType": { "type": "string", "minLength": 1 },
    "aggregateId": { "type": "string", "minLength": 1 },
    "aggregateVersion": { "type": "integer", "minimum": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "causationId": { "type": "string", "minLength": 1 },
    "actorType": {
      "enum": ["user", "service", "agent", "system"]
    },
    "actorId": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" }
  }
}
